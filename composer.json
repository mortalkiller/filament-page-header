{
    "name": "mortalkiller/filament-page-header",
    "description": "Opt-in, schema-based Filament page headers with responsive sticky and compact modes.",
    "homepage": "https://github.com/mortalkiller/filament-page-header",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/mortalkiller/filament-page-header/issues",
        "source": "https://github.com/mortalkiller/filament-page-header"
    },
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.12.6 || ^5.8.1",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.1",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "MortalKiller\\FilamentPageHeader\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MortalKiller\\FilamentPageHeader\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MortalKiller\\FilamentPageHeader\\PageHeaderServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "post-autoload-dump": "@php vendor/bin/testbench package:discover --ansi",
        "test": "pest",
        "lint": "pint --test",
        "check": [
            "@lint",
            "@test"
        ],
        "browser:prepare": [
            "@php bin/prepare-workbench.php",
            "@php workbench/artisan package:discover",
            "@php workbench/artisan filament:assets"
        ],
        "format": "pint",
        "format:check": "pint --test"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
